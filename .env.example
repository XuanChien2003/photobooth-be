NODE_ENV=development
PORT=8080
MONGO_URI=mongodb://127.0.0.1:27017/nxc
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
# Tùy chọn phục vụ frontend đã build (mặc định backend chỉ phục vụ API):
# FRONTEND_DIST=../photobooth-fe/dist
ADMIN_EMAIL=admin@nxc.local
ADMIN_PASSWORD=replace-with-a-strong-password
# Số giờ lưu ảnh của khách trước khi tự xóa (mặc định 24):
# MEDIA_TTL_HOURS=24
# Giới hạn dung lượng toàn cluster MongoDB Atlas (MB = 1024² byte), mặc định 512:
# MEDIA_STORAGE_LIMIT_MB=512
# R2: keep gridfs until the private bucket and credentials are configured.
MEDIA_STORAGE_PROVIDER=gridfs
# R2_ACCOUNT_ID=60387d55b30e91f155c48f0e8bcbd15a
# R2_BUCKET=nxc-media
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_PREFIX=media/
# R2_STORAGE_LIMIT_GB=10
# After npm run r2:check succeeds, change MEDIA_STORAGE_PROVIDER=r2.
# Chỉ đặt trên máy tính Windows ở tiệm:
# Tên máy in DNP trong Windows, hoặc tên hàng in trên Mac (`lpstat -e`, vd. DS_RX1)
# (để trống = lễ tân in thủ công từ Hàng chờ in):
# DNP_PRINTER_NAME=DS-RX1
# Hàng in thứ hai cho cùng máy DNP, đặt 2inch cut = Enable trong driver.
# DNP_STRIP_PRINTER_NAME=DS-RX1 Strips
# Backend Render and the print agent share a random secret of at least 32 characters.
# PRINT_AGENT_TOKEN=replace-with-a-long-random-secret
# Set only on the Windows / Mac computer running npm run print:agent:
# PRINT_AGENT_API_URL=https://your-render-service.onrender.com
# PRINT_AGENT_BRANCH=Your branch name exactly as in Admin
# Máy in Instax mini Link 3 cạnh máy chụp (Bluetooth Classic, Windows 11) — chỉ trên máy chạy print agent:
# địa chỉ Bluetooth của máy in (đọc một lần: instax --transport ble classic-address)
# INSTAX_ADDRESS=88:B4:36:XX:XX:XX
# python của virtualenv đã cài instax-sdk
# INSTAX_PYTHON=C:\PhotoBooth\instax-sdk\.venv\Scripts\python.exe
